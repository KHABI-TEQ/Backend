PORT=3000

# Email — Resend is preferred for transactional mail (signup/verification).
# Gmail SMTP is only used when RESEND_API_KEY is unset.
RESEND_API_KEY=
RESEND_FROM=Khabi-Teq <notifications@khabiteq.com>
EMAIL_USER=
EMAIL_PASS=
FROM_NAME=Khabi-Teq

# Firebase Admin — required to send FCM push to buyer devices (Android + iOS via FCM)
# Use either the three discrete vars OR the single JSON blob.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional alternative to the three vars above (stringified service-account JSON):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Same-property listing lock (CLIP image similarity). Cosine threshold 0.88 default.
# PROPERTY_IMAGE_SIMILARITY_THRESHOLD=0.88
# PROPERTY_IMAGE_VECTOR_INDEX=property_image_embedding
